{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PORTUWANA",
  "version": "0.1.0",
  "identifier": "com.portuwana.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PORTUWANA",
        "width": 1280,
        "height": 660,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:portuwana.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "binaries/faster-whisper/**/*",
      "binaries/whisper/*.dll",
      "binaries/whisper/whisper-cli.exe",
      "resources/models/*.bin",
      "resources/models/faster-whisper-*/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
